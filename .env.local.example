# ============================================
# UMGEBUNGSVARIABLEN - Agent Platform
# ============================================
# 1. Diese Datei kopieren und in ".env.local" umbenennen
# 2. Alle Werte mit deinen echten Keys ersetzen
# 3. Diese Datei NIEMALS in Git hochladen!
# ============================================

# --- CLERK (Authentication) ---
# Holen von: https://dashboard.clerk.com → Dein Projekt → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_DEIN_CLERK_KEY_HIER
CLERK_SECRET_KEY=sk_test_DEIN_CLERK_SECRET_HIER

# Clerk Weiterleitungen nach Login/Logout
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- SUPABASE (Datenbank) ---
# Holen von: https://supabase.com → Dein Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN_SUPABASE_ANON_KEY_HIER
SUPABASE_SERVICE_ROLE_KEY=DEIN_SUPABASE_SERVICE_ROLE_KEY_HIER

# --- ANTHROPIC (Managed Agents) ---
# API-Key holen von: https://platform.claude.com → Settings → API Keys
# ACHTUNG: Dieser Key bleibt IMMER auf dem Server - niemals im Frontend!
ANTHROPIC_API_KEY=sk-ant-DEIN_ANTHROPIC_KEY_HIER

# Environment-ID einer Managed-Agents-Umgebung
# Holen von: https://platform.claude.com → Managed Agents → Environments → eures auswählen
# Pflicht! Ohne Environment-ID kann KEINE Session gestartet werden.
ANTHROPIC_ENVIRONMENT_ID=env_DEINE_ENV_ID_HIER

# --- STRIPE (Zahlungen) ---
# Holen von: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_DEIN_STRIPE_SECRET_HIER
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET_HIER

# --- APP URL ---
# Lokal: http://localhost:3000
# Auf Vercel: https://deine-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Harter Kostendeckel je Agentenlauf, in ganzen Cent.
# Ohne Wert gilt der Default aus app/api/chat/route.ts (800 = 8,00 USD).
# Seit der Strategist auf claude-opus-5 laeuft, ist der frueher genutzte
# Wert 300 zu knapp — ein Guide mit 20 Briefs liegt grob bei 250-300 Cent.
ANTHROPIC_MAX_LIST_COST_CENT=800

# ── Memory-Speicher (Console) ────────────────────────────────────────────────
# Zwei Speicher mit unterschiedlichem Zugriff. Die Anzeigenamen sind
# verbindlich: der Mount-Pfad im Container entsteht aus ihnen und steht
# woertlich in den Agenten-Prompts.
#
#   kana-wissen      read_only   /mnt/memory/kana-wissen/
#   kana-ergebnisse  read_write  /mnt/memory/kana-ergebnisse/
#
# Loest ANTHROPIC_MEMORY_STORE_IDS ab (das bleibt als Rueckfall fuer den
# Wissensspeicher bestehen). Siehe docs/speicherorte.md.
#
# ACHTUNG: Speicher sind workspace-gebunden. Welche IDs hier gelten, haengt
# davon ab, gegen welchen Workspace die Instanz laeuft:
#
#   KANA AI         memstore_01176GMhSLzfFSWgyxoQpaXw / memstore_01K2LdhAbGJb5KEKeg4G1Duc
#   Sins 'n Lashes  memstore_01Raq6r9zdmqVGBL5VDe6KCT / memstore_01JCK9JAqCpf9ZfS269mGCiR
#
# Getestet wird gegen den Kundenworkspace — dort liegen die echten Daten.
ANTHROPIC_WISSENS_STORE_ID=memstore_01Raq6r9zdmqVGBL5VDe6KCT
ANTHROPIC_ERGEBNIS_STORE_ID=memstore_01JCK9JAqCpf9ZfS269mGCiR

# Schluessel des Kundenworkspace. Fehlt er, laufen alle Kunden ueber KANA AI.
ANTHROPIC_API_KEY_SNL=
